<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="java.util.List,com.codegym.inotes.model.Note" %>
<html><head><title>iNotes</title></head><body><h1>iNotes Dashboard</h1><form method="get" action="notes"><input name="keyword" placeholder="Tìm kiếm"><button>Tìm kiếm</button></form><h2>Thêm mới</h2><form method="post" action="notes"><input name="title" placeholder="Tiêu đề" required><select name="typeId"><option value="1">Cá nhân</option><option value="2">Công việc</option><option value="3">Học tập</option></select><textarea name="content" placeholder="Nội dung" required></textarea><button>Lưu ghi chú</button></form><table border="1"><tr><th>#</th><th>Tiêu đề</th><th>Nội dung</th><th>Phân loại</th><th>Thao tác</th></tr><% for(Note n:(List<Note>)request.getAttribute("notes")){ %><tr><td><%=n.getId()%></td><td><%=n.getTitle()%></td><td><%=n.getContent()%></td><td><%=n.getTypeId()%></td><td><a href="notes?action=delete&id=<%=n.getId()%>">Xóa</a></td></tr><% } %></table></body></html>
